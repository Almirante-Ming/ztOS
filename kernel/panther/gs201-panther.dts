// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 (panther) - M1 first-light board file.
 *
 * Same SoC and, by the stock dtbo, the same PMICs, charger, fuel gauge,
 * haptics, amplifiers, Wi-Fi/BT and GNSS parts as the Pixel 7 Pro
 * (cheetah). What differs: the panel (Samsung S6E3FC3, 1080x2400, 60/90 Hz)
 * and the touch controller (Focaltech, on SPI). This file only switches on
 * what the bootloader already leaves running or what is board-independent
 * on gs201: the boot framebuffer, USB, UFS and the keys; and what has been
 * brought up on the phone since: touch, GPU, display. Everything else stays
 * disabled until it is proven on the phone.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7";
	compatible = "google,gs201-panther", "google,gs201";

	/* ABL base-DTB match, as cheetah: B0 = 0x09855001 */
	soc_id = <0x09855001 0x0>;

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these */
		bootargs = "console=tty0 fbcon=font:TER16x32 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init mem_sleep_default=s2idle";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * What ABL scans out from DECON0 (S6E3FC3 panel): ABL's own
		 * splash@fac00000 carve-out, seen on this phone (2026-10-25).
		 */
		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* same pins as cheetah and felix (factory key-voldown/volup/power) */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * The battery, from the stock dtbo's google,battery (entry 22, PANTHER
	 * MP): google,chg-battery-capacity 4277 mAh, the top of
	 * google,chg-cv-limits (4.2/4.3/4.45 V) and the gauge model's VEmpty.
	 * The charge limits are for the charger cell (pmic@66): 4.45 V, the
	 * top CV step, and 0.3C (1266720 uA, the nearest CHGCC step under
	 * 0.3 x 4277 mAh). The temperature guard (max77759_charger temp_guard)
	 * steps both down by stock's google,chg-temp-limits table.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4277000>;
		voltage-max-design-microvolt = <4450000>;
		voltage-min-design-microvolt = <3300000>;
		constant-charge-voltage-max-microvolt = <4450000>;
		constant-charge-current-max-microamp = <1266720>;
	};

	/* UFS VCC: gpp0-1, left on by the bootloader (as cheetah) */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * WL_REG_ON of the BCM4389 (gph2-4, as on cheetah and in the stock
	 * dtbo). Google raises it and waits 200 ms before training the link
	 * (WIFI_TURNON_DELAY in bcmdhd). Modelled as the root port's supply so
	 * the PCI pwrctrl core switches it around link training.
	 */
	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gph2 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-0 = <&wlan_reg_on>;
		pinctrl-names = "default";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/* stock's pstore region, readable from the stock slot after a warm reboot */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};

		/*
		 * All of the Wi-Fi chip's DMA buffers come from this pool, as on
		 * cheetah: it keeps driver bugs away from the rest of RAM (not
		 * the chip's own firmware).
		 */
		wifi_dma_pool: wifi-dma-pool {
			compatible = "restricted-dma-pool";
			size = <0x1000000>;
			alignment = <0x0 0x200000>;
			/* the chip's writes above 4 GiB are not seen */
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};

		/* gs-decon's scanout buffers: DPP0 takes 32-bit addresses */
		display_pool: display-pool {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4000000>;
			/* read with the root's #address-cells (2), not #size-cells */
			alignment = <0x0 0x200000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/*
 * The bootloader leaves DECON0 -> DSIM0 -> panel running in command mode
 * with DSC (1080x2400, 4 lanes at 1102 Mbps, 60 Hz), as on cheetah.
 * gs-decon (flip-only KMS) takes the screen over from simpledrm once it,
 * the DSIM and the panel drivers have probed.
 */
&dsi0 {
	status = "okay";

	panel: panel@0 {
		compatible = "samsung,s6e3fc3";
		reg = <0>;
		/* high = running; the bootloader leaves it high (stock dtbo: gpa7-1) */
		reset-gpios = <&gpa7 1 GPIO_ACTIVE_LOW>;
		/* vddi (S2MPG13 BUCKA), vci (S2MPG12 LDO27): no driver yet */
		width-mm = <66>;
		height-mm = <146>;
	};
};

&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";
};

&cmu_dpu {
	status = "okay";
};

&cmu_disp {
	status = "okay";
};

/* Mali-G710 (Panthor), as cheetah: the G3D rails follow the PMU power domain and ACPM */
&gpu {
	status = "okay";
};

/*
 * Main PMIC, for the touchscreen's two LDOs and its RTC. With the interrupt
 * (GIC SPI 72, as cheetah and stock) the driver also adds the RTC: the
 * clock across reboots and the wake-up timer for suspend (omarchy-mobile
 * SUSPEND-PLAN S3b). It only reads and writes the RTC and the interrupt
 * masks. Only the LDOs described here can be switched; the rest stay as
 * the bootloader set them.
 */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
		google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
		wakeup-source;

		regulators {
			/*
			 * L25M_TSP_DVDD and L26M_TS_AVDD, stock's ranges, so
			 * nothing sets a voltage at probe. Off at hand-off on
			 * this phone: the FT3658 does not answer without them.
			 */
			ldo25m: ldo25m {
				regulator-name = "vdd_ts";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};

			ldo26m: ldo26m {
				regulator-name = "avdd_ts";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

/*
 * Touchscreen: FocalTech FT3658 on USI0 SPI, from the stock dtbo (entry 22,
 * focaltech,ts): cheetah's bus, chip select, IRQ and reset pins, stock's
 * supplies. gph1-0 (ap2aoc-spi-sel) is the AoC's claim on the bus, which
 * nothing makes without an AoC driver: it reads low, the AP's.
 */
&usi0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_0 {
	pinctrl-0 = <&spi0_bus &spi0_miso &spi0_cs_gpio>;
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	status = "okay";

	touchscreen@0 {
		compatible = "focaltech,ft3658";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&ldo25m>;
		avdd-supply = <&ldo26m>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

/*
 * Wi-Fi: BCM4389 on PCIe GEN4A_1, as on cheetah (stock dtbo: bcmdhd_wlan on
 * pcie_1, ch-num 1, the same pins). Firmware from the factory image
 * (tools/extract-vendor-firmware-panther): brcmfmac4389c1-pcie.<board>.*
 */
&pcie_1 {
	status = "okay";
	pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>, <&wlan_dev_wake>,
		    <&wlan_host_wake>;
	pinctrl-names = "default";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_pwr>;

		wifi@0,0 {
			compatible = "pci14e4,4441";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,gs201-panther";
			memory-region = <&wifi_dma_pool>;
		};
	};
};

&pcie_1_phy {
	status = "okay";
};

/* disabled, as on cheetah: PCIe and UFS share its VID 0 */
&pcie_1_sysmmu {
	google,dma-window = <&wifi_dma_pool>;
};

/*
 * Bluetooth: the BCM4389 BT core on the APM USI1 UART, as on cheetah (stock
 * dtbo: btbcm with BT_REG_ON gpp16-2, BT_DEV_WAKE gpp16-3, host wake gpa6-6).
 */
&cmu_apm {
	status = "okay";
};

&usi_apm1 {
	status = "okay";
};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4389-bt";
		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		pinctrl-0 = <&bt_reg_on &bt_dev_wake &bt_host_wake>;
		pinctrl-names = "default";
		max-speed = <3000000>;
	};
};

&pinctrl_peric0 {
	status = "okay";

	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpp16-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_dev_wake: bt-dev-wake-pins {
		samsung,pins = "gpp16-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_far_alive {
	wlan_host_wake: wlan-host-wake-pins {
		samsung,pins = "gpa6-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_host_wake: bt-host-wake-pins {
		samsung,pins = "gpa6-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_hsi2 {
	wlan_reg_on: wlan-reg-on-pins {
		samsung,pins = "gph2-4";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};

	wlan_dev_wake: wlan-dev-wake-pins {
		samsung,pins = "gph2-5";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};
};

/*
 * The AoC (audio and sensor DSP), as cheetah's aoc-core-test overlay:
 * Trusty starts it (hwmgr.aoc), the GSA authenticates aoc.bin (from the
 * factory image). The modules stay blacklisted from autoload; ztos-aoc-start
 * loads them in order. Board id and revision from the stock dtbo (aoc-board-id,
 * aoc-board-rev, board config "P10"); the sensor rails are cheetah's
 * (LDO7S, LDO5S).
 */
&trusty {
	status = "okay";
};

&gsa {
	status = "okay";
};

&aoc_sysmmu {
	status = "okay";
};

&aoc_mbox_a32 {
	status = "okay";
};

&aoc_mbox_f1 {
	status = "okay";
};

&aoc_mbox_p6 {
	status = "okay";
};

&aoc {
	google,board-id = <0x30401>;
	google,board-rev = <0x10000>;
	status = "okay";
};

/*
 * Speaker amplifiers: two Cirrus Logic CS35L41 (revision B2) on PERIC0 USI7
 * SPI, as on cheetah (Google's gs201-cheetah-audio.dtsi); the stock panther
 * dtbo has the same bus, chip selects, resets and interrupts. Chip select 0
 * is the top speaker, which is also the earpiece; chip select 1 is the bottom
 * loudspeaker. Their audio port (TDM) is wired to the AoC audio DSP, so
 * the sound card (gs201-panther-audio.dtsi) plays through the AoC.
 *
 * The boost values are the stock ones, except the peak current: 2.5 A (stock
 * speaker playback) instead of the stock DT default of 3.5 A (voice calls),
 * until the bring-up gates in AUDIO-PLAN.md have passed. The inductor and
 * capacitor values select the boost loop coefficients and must stay as they
 * are.
 */
/ {
	/* S2MPG13 BUCKA ("SA"), always on; no S2MPG13 regulator driver yet. */
	amp_va: regulator-amp-va {
		compatible = "regulator-fixed";
		regulator-name = "amp-va";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* The amplifiers' VP pins sit directly on VSYS (stock: V_SYS_DUMMY). */
	amp_vp: regulator-amp-vp {
		compatible = "regulator-fixed";
		regulator-name = "amp-vp";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&usi7 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_7 {
	pinctrl-0 = <&spi7_bus &spi7_miso &amp_top_cs &amp_bottom_cs>;
	cs-gpios = <&gpp14 3 GPIO_ACTIVE_LOW>, <&gpp22 1 GPIO_ACTIVE_LOW>;
	num-cs = <2>;
	status = "okay";

	amp_top: amplifier@0 {
		compatible = "cirrus,cs35l41";
		reg = <0>;
		#sound-dai-cells = <1>;
		interrupts-extended = <&gpa6 3 IRQ_TYPE_LEVEL_HIGH>;
		/* AMP1_RESET_L: the driver drives 1 to release reset */
		reset-gpios = <&gpp17 1 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_top_irq &amp_top_rst>;
		pinctrl-names = "default";
		VA-supply = <&amp_va>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Top";
		cirrus,subsystem-id = "panther";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <2500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		/* GPIO2 = push-pull interrupt, active high */
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
	};

	amp_bottom: amplifier@1 {
		compatible = "cirrus,cs35l41";
		reg = <1>;
		#sound-dai-cells = <1>;
		interrupts-extended = <&gpa8 6 IRQ_TYPE_LEVEL_HIGH>;
		/* AMP2_RESET_L: the driver drives 1 to release reset */
		reset-gpios = <&gpp25 2 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_bottom_irq &amp_bottom_rst>;
		pinctrl-names = "default";
		VA-supply = <&amp_va>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Bottom";
		cirrus,subsystem-id = "panther";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <2500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
	};
};

&pinctrl_far_alive {
	amp_top_irq: amp-top-irq-pins {
		samsung,pins = "gpa6-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_bottom_irq: amp-bottom-irq-pins {
		samsung,pins = "gpa8-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	amp_top_cs: amp-top-cs-pins {
		samsung,pins = "gpp14-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_5_MA>;
	};

	amp_top_rst: amp-top-rst-pins {
		samsung,pins = "gpp17-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	status = "okay";

	amp_bottom_cs: amp-bottom-cs-pins {
		samsung,pins = "gpp22-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_bottom_rst: amp-bottom-rst-pins {
		samsung,pins = "gpp25-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

/* The AoC sound card, with the amplifiers above as its TDM 0 codecs */
#include "gs201-panther-audio.dtsi"

/* The cameras: main, ultrawide and front */
#include "gs201-panther-camera.dtsi"

/*
 * MAX77759 on USI13 (I2C 13), as on cheetah and in the stock dtbo (fragment
 * 42): Type-C port controller @25, fuel gauge @36, PMIC/charger @66 and @69.
 * All of its interrupt lines are on ALIVE gpa9, active low with pull-ups.
 *
 * The fuel gauge and the PMIC/charger (pmic@66) are on; the Type-C port
 * controller @25 is not, because the USB link is our only way into the
 * phone. Without it no "tcpm-source" ever reports a source, so the charger
 * runs as on cheetah (omarchy-mobile USB-C-PLAN, gate D1): modprobe options
 * default_ilim_ua=500000 (charge at once, as the bootloader did) and
 * temp_guard=1, keep_wcin=1 (kernel/panther/patches/0005: the wireless
 * input stays on and counts as a source). omamobile-usb-rescue closes the
 * USB data switch the port controller opens on unplug.
 */
&usi13 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_13 {
	clock-frequency = <400000>;
	status = "okay";

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa9 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		/* maxim,rsense-default = <500> (10 uOhm units) in the stock dtbo */
		shunt-resistor-micro-ohms = <5000>;
		monitored-battery = <&battery>;

		/*
		 * Battery model for the pack with a 1 kOhm ID resistor (ATL,
		 * DesignCap 0x0873 = 4326 mAh), from the stock dtbo's
		 * maxim,fg-data (batt-id-kohm 1, model version 2), except
		 * RelaxCfg 0x143b, the value stock writes over the model's at
		 * boot (maxim,r_regval_1720x = <0x2a143b>). FilterCfg is already
		 * stock's filtercfg-default (0xc613).
		 *
		 * The driver only writes a model after a gauge power-on reset
		 * (the battery fully drained or disconnected); otherwise it
		 * keeps the one stock loaded, and charge_full_design shows which
		 * pack this is. The other pack (3 kOhm, LSN, DesignCap 0x0891 =
		 * 4386 mAh) would be:
		 *   fg-model: 0xa4f0 0xb750 0xb8b0 0xba50 0xbbe0 0xbd60 0xbe70
		 *     0xbf80 0xc170 0xc320 0xc960 0xced0 0xd210 0xd580 0xd8a0
		 *     0xdc60 0x0160 0x0f30 0x0e00 0x1210 0x1500 0x1800 0x1520
		 *     0x0da0 0x0be0 0x07f0 0x06c0 0x06f0 0x06e0 0x06f0 0x05f0
		 *     0x05f0, then 16 x 0x0200
		 *   fg-params: as below with DesignCap/FullCapRep/FullCapNom
		 *     0x0891, dQAcc 0x0224, QRTable 0x2500 0x1180 0x0780 0x0580,
		 *     TempCo 0x1802
		 */
		maxim,fg-model = /bits/ 16 <
			0x8c80 0xb770 0xb8f0 0xba50 0xbb40 0xbc30 0xbe00 0xbfd0
			0xc1b0 0xc3a0 0xc6b0 0xc9c0 0xd020 0xd300 0xd5e0 0xdc30
			0x0080 0x1070 0x1020 0x0ed0 0x0f00 0x1700 0x1530 0x0c20
			0x0c40 0x07f0 0x07f0 0x06f0 0x0710 0x06d0 0x06f0 0x06f0
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
			0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200 0x0200
		>;
		maxim,fg-params = /bits/ 16 <
			0xf060	/* IAvgEmpty */
			0x143b	/* RelaxCfg (stock's, not the model's 0x0839) */
			0x260e	/* LearnCfg */
			0x4217	/* Config: external thermistor, TEx clear */
			0x0090	/* Config2 */
			0x5f00	/* FullSOCThr */
			0x0873	/* FullCapRep */
			0x0873	/* DesignCap */
			0x3200	/* dPAcc */
			0x021c	/* dQAcc */
			0x0873	/* FullCapNom */
			0xa561	/* VEmpty */
			0x1f00	/* QRTable00 */
			0x0d80	/* QRTable10 */
			0x0480	/* QRTable20 */
			0x0400	/* QRTable30 */
			0x0740	/* RComp0 */
			0x1a02	/* TempCo */
			0x0557	/* IChgTerm */
			0xed51	/* TGain */
			0x1eba	/* TOff */
			0x0014	/* Curve */
			0x3870	/* MiscCfg */
			0x1900	/* AtRate */
			0x2241	/* ConvgCfg */
			0xc613	/* FilterCfg */
			0x2d00	/* TaskPeriod */
		>;
	};

	/* stock: max77759 (fragment 39), irq gpa9-4 (if-pmic-irq) */
	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa9 4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;
		monitored-battery = <&battery>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&pinctrl_gpio_alive {
	/* the PMIC's interrupt line (stock: if-pmic-irq, gpa9-4) */
	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	/* the fuel gauge's ALRT line (stock: if-pmic-fg-irq, gpa9-3) */
	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa9-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};
