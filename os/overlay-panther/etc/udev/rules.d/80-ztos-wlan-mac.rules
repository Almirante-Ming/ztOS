# SPDX-License-Identifier: MIT
# ztOS: set the Wi-Fi MAC from the bootloader before NetworkManager
# takes the link (ztos-wlan-mac). $name, not %k: by the time RUN
# runs, 80-net-setup-link has renamed wlan0 to wlp1s0.
ACTION=="add", SUBSYSTEM=="net", DRIVERS=="brcmfmac", RUN+="/usr/local/bin/ztos-wlan-mac $name"
